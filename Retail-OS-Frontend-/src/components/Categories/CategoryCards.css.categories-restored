/* =========================================
   Category Cards Container
========================================= */

.category-cards {
    width: 100%;

    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));

    gap: 12px;

    margin: 0 0 14px;
}


/* =========================================
   Category Card
========================================= */

.category-card {
    position: relative;

    min-height: 72px;

    padding: 14px 16px;

    background: #ffffff;

    border: 1px solid #e5e7eb;
    border-radius: 10px;

    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.05);

    box-sizing: border-box;

    overflow: hidden;

    transition:
        box-shadow 0.18s ease,
        transform 0.18s ease,
        border-color 0.18s ease,
        background-color 0.18s ease;
}


/* =========================================
   Card Left Accent
========================================= */

.category-card::before {
    content: "";

    position: absolute;

    left: 0;
    top: 0;
    bottom: 0;

    width: 3px;

    background: #6366f1;

    opacity: 0;

    transition: opacity 0.18s ease;
}


/* =========================================
   Card Hover
========================================= */

.category-card:hover {
    transform: translateY(-1px);

    border-color: #dbe1ea;

    box-shadow: 0 4px 12px rgba(15, 23, 42, 0.08);

    background: #ffffff;
}

.category-card:hover::before {
    opacity: 1;
}


/* =========================================
   Card Title
========================================= */

.category-card h3 {
    margin: 0 0 6px;

    font-size: 10px;

    line-height: 1.4;

    font-weight: 600;

    color: #64748b;

    letter-spacing: 0.01em;
}


/* =========================================
   Card Value
========================================= */

.category-card h2 {
    margin: 0;

    font-size: 22px;

    line-height: 1.2;

    font-weight: 700;

    color: #111827;
}


/* =========================================
   Tablet
========================================= */

@media (max-width: 992px) {

    .category-cards {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}


/* =========================================
   Mobile
========================================= */

@media (max-width: 576px) {

    .category-cards {
        grid-template-columns: 1fr;

        gap: 10px;
    }

    .category-card {
        min-height: 68px;

        padding: 13px 15px;
    }

    .category-card h2 {
        font-size: 21px;
    }
}
