/* =========================================
   Category Header
========================================= */

.category-header {
    width: 100%;
    background: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 20px 22px 0;
    margin-bottom: 14px;
    box-shadow: 0 1px 3px rgba(15, 23, 42, 0.05);
    box-sizing: border-box;

    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
}


/* =========================================
   Header Top Section
========================================= */

.category-header-left {
    flex: 1;
    min-width: 0;
    max-width: 70%;
}

.category-header-left h1 {
    margin: 0 0 6px;
    font-size: 24px;
    line-height: 1.25;
    font-weight: 700;
    color: #111827;
}

.category-header-left p {
    margin: 0;
    color: #64748b;
    font-size: 12px;
    line-height: 1.5;
}


/* =========================================
   Header Buttons
========================================= */

.category-header-right {
    margin-left: auto;

    display: flex;
    align-items: center;
    gap: 8px;

    flex-shrink: 0;
}

.category-btn {
    height: 34px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    padding: 0 14px;

    border-radius: 7px;
    cursor: pointer;

    font-size: 12px;
    font-weight: 600;

    transition:
        background-color 0.18s ease,
        border-color 0.18s ease,
        box-shadow 0.18s ease,
        transform 0.15s ease;
}


/* =========================================
   Primary Button
========================================= */

.primary-btn {
    border: 1px solid #4f46e5;
    background: #4f46e5;
    color: #ffffff;
}

.primary-btn:hover {
    background: #4338ca;
    border-color: #4338ca;
    box-shadow: 0 3px 8px rgba(79, 70, 229, 0.18);
    transform: translateY(-1px);
}


/* =========================================
   Secondary Button
========================================= */

.secondary-btn {
    background: #ffffff;
    color: #374151;
    border: 1px solid #d1d5db;
}

.secondary-btn:hover {
    background: #f8fafc;
    border-color: #cbd5e1;
}


/* =========================================
   Category Tabs
========================================= */

.category-tabs {
    width: 100%;
    margin-top: 20px;

    display: flex;
    align-items: center;
    gap: 6px;

    border-top: 1px solid #e5e7eb;

    padding: 12px 0 10px;

    overflow-x: auto;
    scrollbar-width: none;
}

.category-tabs::-webkit-scrollbar {
    display: none;
}

.category-tab {
    flex-shrink: 0;

    padding: 8px 12px;

    border-radius: 7px;

    background: transparent;
    color: #64748b;

    font-size: 11px;
    font-weight: 600;

    cursor: pointer;

    transition:
        background-color 0.18s ease,
        color 0.18s ease;
}

.category-tab:hover {
    background: #f8fafc;
    color: #475569;
}

.active-tab {
    background: #eef2ff;
    color: #4f46e5;
}


/* =========================================
   Responsive
========================================= */

@media (max-width: 768px) {

    .category-header {
        padding: 16px 16px 0;
    }

    .category-header-left {
        width: 100%;
        max-width: 100%;
    }

    .category-header-right {
        width: 100%;
        margin-top: 16px;
        justify-content: flex-start;
    }

    .category-tabs {
        margin-top: 16px;
    }

    .category-header-left h1 {
        font-size: 21px;
    }
}


@media (max-width: 480px) {

    .category-header-right {
        gap: 8px;
    }

    .category-btn {
        flex: 1;
    }

    .category-tabs {
        gap: 4px;
    }

    .category-tab {
        padding: 7px 10px;
        font-size: 10px;
    }
}
