/* =========================================
   Category Modal Overlay
========================================= */

.category-modal-overlay {
    position: fixed;
    inset: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    padding: 20px;

    background: rgba(15, 23, 42, 0.45);

    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);

    z-index: 9999;
}


/* =========================================
   Modal Box
========================================= */

.category-modal {
    width: 460px;
    max-width: 100%;

    background: #ffffff;

    border: 1px solid #e5e7eb;
    border-radius: 12px;

    box-shadow:
        0 20px 40px rgba(15, 23, 42, 0.16),
        0 4px 12px rgba(15, 23, 42, 0.08);

    overflow: hidden;

    animation: categoryModalPopup 0.22s ease-out;
}


/* =========================================
   Modal Animation
========================================= */

@keyframes categoryModalPopup {
    from {
        opacity: 0;
        transform: translateY(-12px) scale(0.98);
    }

    to {
        opacity: 1;
        transform: translateY(0) scale(1);
    }
}


/* =========================================
   Modal Header
========================================= */

.modal-header {
    display: flex;
    align-items: center;
    justify-content: space-between;

    padding: 18px 22px;

    background: #ffffff;

    border-bottom: 1px solid #eef2f7;
}


/* Header Title */

.modal-header h2 {
    margin: 0;

    font-size: 18px;
    line-height: 1.4;

    font-weight: 700;

    color: #111827;
}


/* =========================================
   Close Button
========================================= */

.close-btn {
    width: 32px;
    height: 32px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    padding: 0;

    border: 1px solid transparent;
    border-radius: 7px;

    background: transparent;

    color: #64748b;

    font-size: 22px;
    line-height: 1;

    cursor: pointer;

    transition:
        background-color 0.18s ease,
        color 0.18s ease,
        border-color 0.18s ease;
}

.close-btn:hover {
    background: #fef2f2;

    border-color: #fecaca;

    color: #dc2626;
}

.close-btn:focus-visible {
    outline: none;

    box-shadow:
        0 0 0 3px rgba(79, 70, 229, 0.12);
}


/* =========================================
   Modal Body
========================================= */

.modal-body {
    padding: 22px;
}


/* =========================================
   Form Group
========================================= */

.form-group {
    margin-bottom: 18px;
}

.form-group:last-child {
    margin-bottom: 0;
}


/* =========================================
   Form Label
========================================= */

.form-group label {
    display: block;

    margin-bottom: 7px;

    font-size: 12px;
    line-height: 1.4;

    font-weight: 600;

    color: #374151;
}


/* =========================================
   Input + Textarea
========================================= */

.form-group input,
.form-group textarea,
.form-group select {
    width: 100%;

    box-sizing: border-box;

    border: 1px solid #d1d5db;
    border-radius: 7px;

    background: #ffffff;

    color: #1f2937;

    font-family: inherit;

    font-size: 13px;

    outline: none;

    transition:
        border-color 0.18s ease,
        box-shadow 0.18s ease,
        background-color 0.18s ease;
}


/* Input */

.form-group input {
    height: 40px;

    padding: 0 12px;
}


/* Textarea */

.form-group textarea {
    min-height: 95px;

    padding: 10px 12px;

    resize: vertical;

    line-height: 1.5;
}


/* Placeholder */

.form-group input::placeholder,
.form-group textarea::placeholder {
    color: #9ca3af;
}


/* =========================================
   Input / Textarea Focus
========================================= */

.form-group input:focus,
.form-group textarea:focus,
.form-group select:focus {
    border-color: #6366f1;

    box-shadow:
        0 0 0 3px rgba(99, 102, 241, 0.10);
}


/* =========================================
   Modal Footer
========================================= */

.modal-footer {
    display: flex;
    align-items: center;
    justify-content: flex-end;

    gap: 10px;

    padding: 16px 22px;

    background: #fafbfc;

    border-top: 1px solid #eef2f7;
}


/* =========================================
   Common Button Style
========================================= */

.cancel-btn,
.save-btn {
    height: 36px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    padding: 0 16px;

    border-radius: 7px;

    font-family: inherit;

    font-size: 12px;

    font-weight: 600;

    cursor: pointer;

    transition:
        background-color 0.18s ease,
        border-color 0.18s ease,
        color 0.18s ease,
        box-shadow 0.18s ease,
        transform 0.15s ease;
}


/* =========================================
   Cancel Button
========================================= */

.cancel-btn {
    border: 1px solid #d1d5db;

    background: #ffffff;

    color: #374151;
}

.cancel-btn:hover {
    background: #f8fafc;

    border-color: #9ca3af;

    color: #1f2937;
}

.cancel-btn:active {
    transform: translateY(1px);
}


/* =========================================
   Save Button
========================================= */

.save-btn {
    border: 1px solid #4f46e5;

    background: #4f46e5;

    color: #ffffff;

    box-shadow:
        0 1px 2px rgba(79, 70, 229, 0.15);
}

.save-btn:hover {
    background: #4338ca;

    border-color: #4338ca;

    box-shadow:
        0 3px 8px rgba(79, 70, 229, 0.18);

    transform: translateY(-1px);
}

.save-btn:active {
    background: #3730a3;

    border-color: #3730a3;

    transform: translateY(0);
}


/* =========================================
   Button Focus
========================================= */

.cancel-btn:focus-visible,
.save-btn:focus-visible {
    outline: none;

    box-shadow:
        0 0 0 3px rgba(79, 70, 229, 0.12);
}


/* =========================================
   Responsive - Tablet
========================================= */

@media (max-width: 600px) {

    .category-modal-overlay {
        padding: 16px;
    }

    .category-modal {
        width: 100%;
        max-width: 460px;
    }

    .modal-header {
        padding: 16px 18px;
    }

    .modal-body {
        padding: 18px;
    }

    .modal-footer {
        padding: 14px 18px;
    }
}


/* =========================================
   Responsive - Mobile
========================================= */

@media (max-width: 480px) {

    .category-modal-overlay {
        align-items: center;

        padding: 12px;
    }

    .category-modal {
        width: 100%;

        border-radius: 10px;
    }

    .modal-header h2 {
        font-size: 17px;
    }

    .modal-body {
        padding: 18px 16px;
    }

    .modal-footer {
        flex-direction: column;

        align-items: stretch;

        gap: 8px;

        padding: 14px 16px;
    }

    .cancel-btn,
    .save-btn {
        width: 100%;
    }
}
