.category-cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
    margin: 20px 0;
}

.category-card {
    background: #ffffff;
    border-radius: 16px;
    padding: 22px;
    border: 1px solid #e5e7eb;
    box-shadow: 0 2px 12px rgba(0,0,0,.05);
    transition: 0.3s;
}

.category-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 8px 24px rgba(0,0,0,.08);
}

.category-card h3 {
    font-size: 14px;
    color: #6b7280;
    margin-bottom: 10px;
    font-weight: 600;
}

.category-card h2 {
    font-size: 30px;
    color: #111827;
    font-weight: 700;
}

@media (max-width: 992px) {
    .category-cards {
        grid-template-columns: repeat(2,1fr);
    }
}

@media (max-width: 576px) {
    .category-cards {
        grid-template-columns: 1fr;
    }
}